# Coinmirror public web configuration
# Do not put secrets here. EXPO_PUBLIC_* values are embedded in the web bundle.

# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX
EXPO_PUBLIC_GA_MEASUREMENT_ID=

# Optional Google Form/Tally/Typeform URL for subscription waitlist interest.
# Keep email collection outside GA; never send email values to analytics events.
EXPO_PUBLIC_WAITLIST_FORM_URL=

# Optional Google Form/Tally/Typeform URL for qualitative feedback after result view.
# Keep raw trading details out of required questions unless the user chooses to describe issues voluntarily.
EXPO_PUBLIC_FEEDBACK_FORM_URL=
